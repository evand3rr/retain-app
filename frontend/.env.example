# Optional. Leave VITE_API_URL unset to use the same origin ("/api"), which works with the dev proxy and the
# single-service deployment. Set it only if the API is hosted on a different domain, e.g.:
# VITE_API_URL=https://retain-api.onrender.com/api

# Currency used when formatting amounts (ISO 4217 code)
VITE_CURRENCY=USD
